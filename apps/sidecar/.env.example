NODE_ENV=development
PORT=3001
TCP_HOST=0.0.0.0
TCP_PORT=9100
# Pre-published range for dynamic listeners. Must match compose port publish range.
TCP_PORT_RANGE=9100-9199
LARAVEL_INTERNAL_URL=http://web:8080/api/internal/v1
SIDECAR_SHARED_TOKEN=dev-sidecar-token
LOG_LEVEL=debug
JOB_IDLE_TIMEOUT_MS=1500
MAX_PAYLOAD_BYTES=1048576
